<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Takım adının yanındaki küçük kırmızı kart. 2+ kartta içinde sayı yazar. -->
    <style name="RedCardBadge">
        <item name="android:layout_width">10dp</item>
        <item name="android:layout_height">13dp</item>
        <item name="android:background">@drawable/bg_red_card</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">8sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:visibility">gone</item>
    </style>


    <!-- Puan tablosu hücreleri -->
    <style name="StandingCell">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="StandingHeader" parent="StandingCell">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
